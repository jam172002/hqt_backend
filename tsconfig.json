{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Explicit rather than relying on auto-discovery of everything under
    // @types/*: ts-node/ts-jest on this TS 6.0.x toolchain don't reliably
    // pick up ambient globals (process, jest, describe/it/expect) without it.
    "types": ["node", "jest", "multer"]
  }
}
