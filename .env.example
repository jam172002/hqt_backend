# App
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Database (matches docker-compose.yml postgres service)
DATABASE_URL="postgresql://hqt:hqt_dev_password@localhost:5433/hqt_dev?schema=public"

# Auth (generate a real random secret before deploying anywhere real)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are opaque session tokens (bcrypt-hashed server-side), not
# signed JWTs, so there is no refresh secret - only how long a session lasts.
JWT_REFRESH_EXPIRES_IN=30d

# Redis / Queue (optional in dev; required once background jobs are wired up)
REDIS_URL=redis://localhost:6380

# Object storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=hqt-media
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_UPLOAD_BYTES=10485760

# External providers (left blank until a provider is chosen — see SRS "Important Decisions Still Required")
PAYMENT_PROVIDER_NAME=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

MEETING_PROVIDER_NAME=
MEETING_PROVIDER_API_KEY=

PUSH_PROVIDER_NAME=
PUSH_PROVIDER_API_KEY=

EMAIL_PROVIDER_NAME=
EMAIL_PROVIDER_API_KEY=

SMS_PROVIDER_NAME=
SMS_PROVIDER_API_KEY=

WHATSAPP_PROVIDER_NAME=
WHATSAPP_PROVIDER_API_KEY=
